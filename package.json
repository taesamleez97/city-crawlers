{
  "name": "city-crawlers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7140 --strictPort",
    "dev:tv": "vite --host 0.0.0.0 --port 7140 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 7140 --strictPort",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/pipeline/build-assets.mjs",
    "assets:arms": "node tools/pipeline/build-assets.mjs arms",
    "assets:props": "node tools/pipeline/build-assets.mjs props",
    "assets:kit": "node tools/pipeline/build-assets.mjs kit",
    "assets:inspect": "gltf-transform inspect"
  },
  "dependencies": {
    "@kabletv/little-sdk": "^0.39.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
